{
  "name": "@rlatn1234/paperless-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for paperless-ngx. Exposes the complete paperless-ngx REST API — documents, tags, correspondents, document types, storage paths, custom fields, bulk operations, workflows, mail rules and administration — to AI assistants.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "./dist/index.js",
  "bin": {
    "paperless-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector node dist/index.js",
    "dev:paperless": "docker compose -f docker-compose.dev.yml up -d",
    "dev:paperless:down": "docker compose -f docker-compose.dev.yml down -v",
    "smoke": "tsx scripts/smoke.ts",
    "gen:openapi": "tsx scripts/gen-openapi.ts",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts"
  },
  "keywords": [
    "mcp",
    "paperless-ngx",
    "paperless",
    "document-management",
    "ai",
    "claude",
    "model-context-protocol"
  ],
  "author": "rlatn1234",
  "contributors": [
    "Nick Loui (original author of nloui/paperless-mcp)"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rlatn1234/paperless-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/rlatn1234/paperless-mcp/issues"
  },
  "homepage": "https://github.com/rlatn1234/paperless-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.17",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
